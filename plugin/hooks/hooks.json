{
  "description": "cc-trace hooks — persistent memory for Claude Code",
  "hooks": {
    "Setup": [{
      "matcher": "*",
      "hooks": [{
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/server-launcher.cjs\"",
        "async": true,
        "timeout": 30
      }]
    }],
    "SessionStart": [{
      "matcher": "*",
      "hooks": [
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/server-launcher.cjs\"", "async": true, "timeout": 30 },
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/inject.cjs\"", "async": true, "timeout": 10 }
      ]
    }],
    "UserPromptSubmit": [{
      "hooks": [
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/server-launcher.cjs\"", "timeout": 10 },
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/capture.cjs\"", "timeout": 10 }
      ]
    }],
    "PostToolUse": [{
      "matcher": "*",
      "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/capture.cjs\"", "timeout": 10 }]
    }],
    "Stop": [{
      "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/summarize.cjs\"", "timeout": 120000 }]
    }]
  }
}
